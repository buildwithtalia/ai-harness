# Claude Code adapter — hits Anthropic directly via @ai-sdk/anthropic.
# Key comes from https://console.anthropic.com/settings/keys.
CLAUDE_API_KEY=

# Codex adapter — hits OpenAI directly via @ai-sdk/openai.
# Key comes from https://platform.openai.com/api-keys.
CODEX_API_KEY=

# Optional: Vercel AI Gateway key. If set, any raw-model target
# (`anthropic/…`, `openai/…`) routes through the gateway instead of the
# direct providers above. Not needed if CLAUDE_API_KEY + CODEX_API_KEY are set.
AI_GATEWAY_API_KEY=

# Devin (POST /v1/sessions + poll)
DEVIN_API_KEY=

# Cursor Background Agents (POST /v0/agents + poll)
CURSOR_API_KEY=
CURSOR_REPOSITORY=

# Context provider: Postman Context Graph — env names match the release-
# autopilot skill in Postman-Devrel/devrel-claude-code-skills PR #3.
POSTMAN_CONTEXT_GRAPH_API_URL=
POSTMAN_CONTEXT_GRAPH_API_KEY=

# Post-run notification to the release-autopilot skill (optional)
SKILL_WEBHOOK_URL=
SKILL_WEBHOOK_TOKEN=
