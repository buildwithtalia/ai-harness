# anthropic/* targets — hits Anthropic directly via @ai-sdk/anthropic.
# Key comes from https://console.anthropic.com/settings/keys.
CLAUDE_API_KEY=

# openai/* targets — hits OpenAI directly via @ai-sdk/openai.
# Key comes from https://platform.openai.com/api-keys.
OPENAI_API_KEY=

# google/* targets — hits Google directly via @ai-sdk/google.
# Key comes from https://aistudio.google.com/apikey (has a free tier).
GOOGLE_API_KEY=

# Vercel AI Gateway key. Fallback transport for anthropic/* and openai/* when
# the direct keys above are unset. Optional if you set the direct keys.
AI_GATEWAY_API_KEY=

# Optional: force a specific LLM judge, overriding the suite's judgeModel.
# Useful when the suite's judge is unavailable for a reason the harness can't
# detect statically — an exhausted provider quota looks like a working key
# until you call it.
AI_HARNESS_JUDGE_MODEL=

# Context provider: Postman Context Graph — env names match the release-
# autopilot skill in Postman-Devrel/devrel-claude-code-skills PR #3.
POSTMAN_CONTEXT_GRAPH_API_URL=
POSTMAN_CONTEXT_GRAPH_API_KEY=

# Post-run notification to the release-autopilot skill (optional)
SKILL_WEBHOOK_URL=
SKILL_WEBHOOK_TOKEN=

# ── Rate limits ───────────────────────────────────────────────────────────
# Every provider call passes through a token bucket keyed on the transport, so
# the limit holds no matter how many cells are in flight. Set these to YOUR
# key's real limits; the built-in defaults assume the lowest tier and will make
# runs slow if you are on a higher one.
#
# TPM is usually what binds, not RPM: a cross-repo cell sends ~600k input
# tokens across its steps, so a 30k TPM key spends twenty minutes on one cell.
#
#   Anthropic  console.anthropic.com  → Settings → Limits
#   OpenAI     platform.openai.com    → Settings → Limits
#   Google     aistudio.google.com    → the free tier is ~10 RPM
#
# Defaults if unset: anthropic 50/30k, openai 500/30k, google 10/250k.
ANTHROPIC_RPM=
ANTHROPIC_TPM=
OPENAI_RPM=
OPENAI_TPM=
GOOGLE_RPM=
GOOGLE_TPM=
